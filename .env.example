# Captain Levi's site backend — environment variables.
# Nothing here is required to run locally: `npm run dev` works with zero credentials
# (PGlite database on disk, chat in scripted mode, emails recorded as pending_config).
# Each variable below says what it unlocks. See docs/BACKEND.md for details.

# --- Database ---------------------------------------------------------------
# postgres://… → pg Pool with SSL (Neon / Vercel Postgres). pglite://<dir> → embedded PGlite (dev/test).
# Unset: PGlite in memory outside production; in production the API reports database:false and refuses writes.
DATABASE_URL=pglite://./.data/dev
# Set to false to stop handlers from applying db/migrations on cold start (then run `npm run migrate` yourself).
AUTO_MIGRATE=true

# --- Secrets ------------------------------------------------------------------
# HMAC key for the cl_session cookie, signed /api/photo URLs and IP hashing. 32+ random bytes, e.g. `openssl rand -hex 32`.
# Unset: an insecure fixed dev key is used and /api/health reports session_secret:false. Never ship production without it.
SESSION_SECRET=
# Staff sign-in for the Quote Desk (/app): allow-listed emails + ONE shared password stored only as a scrypt hash.
#   STAFF_PASSWORD='...' node scripts/hash-password.mjs   → paste the output here / into Vercel. Never store the password.
# Unset: /app shows 'not set up yet' and /api/admin/* only accepts the bearer token below.
STAFF_PASSWORD_HASH=
# Comma-separated staff emails allowed to sign in (default: the owner addresses in site/business.json).
STAFF_EMAILS=tyler.salta@icloud.com,captainlevis@yahoo.com
# Bearer token for /api/admin/* (machine access; optional once staff sign-in is set). Unset: bearer auth disabled.
ADMIN_API_TOKEN=

# --- Cloudflare Turnstile ------------------------------------------------------
# Server secret matching the site key in site/business.json (turnstileSiteKey). Unlocks server-side CAPTCHA verification.
# Unset in production: /api/inquiries answers 503 "call us" unless ALLOW_UNVERIFIED_FORMS=true. Unset in dev: forms accepted.
# Cloudflare's always-pass test secret for local testing: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
ALLOW_UNVERIFIED_FORMS=false

# --- Email (Resend) -------------------------------------------------------------
# Unlocks sending the quote-request email. Unset: inquiries are still stored; email_deliveries rows stay 'pending_config'
# and can be retried later with POST /api/admin/retry-email?id=.
RESEND_API_KEY=
# Sender (domain must be verified in Resend with SPF/DKIM) and recipient.
EMAIL_FROM="Captain Levi's Website <inquiries@captainlevis.com>"
EMAIL_TO=captainlevis@yahoo.com
# Base URL of the Quote Desk, used for the "Open in Quote Builder" button. Default: <SITE_URL>/app
ADMIN_BASE_URL=
# Set true to ALSO include a Claude-written suggested reply in the inquiry email (the rules-based Captain Levi reply is always there).
AI_REPLY_DRAFT=false

# --- Anthropic (chat + suggested-reply drafts) ------------------------------------
# Unlocks the LLM for chat language and reply drafts. Unset: chat runs the same state machine in scripted mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Hard monthly ceiling on logged AI spend (USD). Over budget → scripted mode, no further calls until next month.
AI_MONTHLY_BUDGET_USD=25

# --- Uploads --------------------------------------------------------------------
MAX_PHOTOS=5
MAX_PHOTO_MB=10

# --- Site -----------------------------------------------------------------------
# Public origin used to build absolute links in emails (signed photo URLs). Defaults to siteUrl in site/business.json.
SITE_URL=https://www.captainlevis.com
# Vercel sets VERCEL_ENV=production|preview|development automatically. Setting it locally to production
# turns on production rules (Secure cookies, Turnstile required).
# VERCEL_ENV=
